# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3004

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase Auth (for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret  # Supabase Dashboard → Project Settings → API → JWT Secret

# Email configuration is loaded from the database (settings table)
# No need to configure here - use the application UI
