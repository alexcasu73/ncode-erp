# Porta su cui ascolta il server MCP (Streamable HTTP)
MCP_PORT=3003

# Base URL della REST API ERP (api-server). Es. locale: http://127.0.0.1:3002
API_BASE_URL=http://127.0.0.1:3002

# NB: il MCP è multi-tenant. Non c'è una API key fissa qui:
# ogni client si autentica con la API key della propria azienda
# (header Authorization: Bearer <ncode_...>), generata da Impostazioni → API Keys.
