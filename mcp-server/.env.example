# Porta su cui ascolta il server MCP (Streamable HTTP)
MCP_PORT=3003

# Base URL della REST API ERP (api-server). Es. locale: http://127.0.0.1:3002
API_BASE_URL=http://127.0.0.1:3002

# API key (X-API-Key) con cui il MCP interroga la REST API.
# Determina la company di cui il MCP vede i dati.
API_KEY=ncode_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token bearer opzionale per proteggere l'endpoint /mcp (header Authorization: Bearer <token>).
# Se vuoto, l'endpoint MCP non richiede autenticazione (sconsigliato in produzione).
MCP_AUTH_TOKEN=
