# Porta su cui ascolta il server MCP (Streamable HTTP)
MCP_PORT=3003

# Base URL della REST API ERP (api-server). Es. locale: http://127.0.0.1:3002
API_BASE_URL=http://127.0.0.1:3002

# NB: il MCP è multi-tenant. Non c'è una API key fissa qui:
# ogni client si autentica con la API key della propria azienda
# (vedi sotto come venga passata), generata da Impostazioni → API Keys.

# Token opzionale per proteggere l'endpoint /mcp con un gate aggiuntivo.
# - Vuoto (predefinito, flusso per-utente): il client invia il proprio token
#   personale come `Authorization: Bearer <ncode_...>` (generato in Impostazioni).
# - Valorizzato (consigliato in produzione): il client invia il gate come
#   `Authorization: Bearer <MCP_AUTH_TOKEN>` e il token utente in `X-API-Key`.
# Genera un valore con:  npm run gen-token
MCP_AUTH_TOKEN=
